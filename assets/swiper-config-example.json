{
    "threshold": 5,
    "slidesPerView": 3,
    "observer": true,
    "observeParents": true,
    "loop": true,
    "watchSlidesProgress": true,
    "autoplay": {
        "disableOnInteraction": false,
        "enabled": true,
        "delay": 3000
    },
    "grabCursor": true,
    "effect": "coverflow",
    "speed": 600,
    "centeredSlides": true,
    "keyboard": {
        "enabled": true
    },
    "pagination": {
        "el": ".swiper-pagination",
        "clickable": true
    },
    "navigation": {
        "nextEl": ".swiper-button-next",
        "prevEl": ".swiper-button-prev"
    },
    "breakpoints": {
        "320": {
            "slidesPerView": 1,
            "spaceBetween": 10
        },
        "768": {
            "slidesPerView": 2,
            "spaceBetween": 20
        },
        "1024": {
            "slidesPerView": 3,
            "spaceBetween": 30
        }
    }
}